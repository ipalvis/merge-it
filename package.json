{
  "name": "merge-it",
  "private": true,
  "version": "1.0.0",
  "description": "Drop the pieces of a map into a box; neighbors stick together. Assemble the whole map.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-levels.mjs && vite build",
    "build:single": "vite build --mode single",
    "build:single-test": "vite build --mode single-test",
    "preview": "vite preview",
    "build:map": "node scripts/build-map.mjs",
    "check:levels": "node scripts/check-levels.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/public-sans": "5.3.0",
    "matter-js": "0.19.0"
  },
  "devDependencies": {
    "poly-decomp": "0.3.0",
    "prettier": "3.9.9",
    "simplify-js": "1.2.4",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "world-atlas": "2.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
